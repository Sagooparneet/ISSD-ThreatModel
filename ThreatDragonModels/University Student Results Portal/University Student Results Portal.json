import json, uuid, os, textwrap, math

out_path = "/mnt/data/University_Student_Results_Portal_ThreatDragon_v2.6.2_ORGANISED.json"

def uid():
    return str(uuid.uuid4())

ids = {k: uid() for k in ["student","lecturer","admin","internet","webapp","appserver","db"]}

def actor(key, name, x, y, z):
    return {
        "position": {"x": x, "y": y},
        "size": {"width": 150, "height": 70},
        "attrs": {
            "text": {"text": name},
            "body": {"stroke": "#333333", "strokeWidth": 1, "strokeDasharray": None}
        },
        "shape": "actor",
        "zIndex": z,
        "id": ids[key],
        "data": {
            "type": "tm.Actor",
            "name": name,
            "description": f"{name} user of the University Student Results Portal.",
            "outOfScope": False,
            "reasonOutOfScope": "",
            "providesAuthentication": False,
            "hasOpenThreats": False,
            "threats": []
        }
    }

def process(key, name, x, y, z, desc):
    return {
        "position": {"x": x, "y": y},
        "size": {"width": 125, "height": 95},
        "attrs": {
            "text": {"text": name},
            "body": {"stroke": "#333333", "strokeWidth": 1, "strokeDasharray": None}
        },
        "shape": "process",
        "zIndex": z,
        "id": ids[key],
        "data": {
            "type": "tm.Process",
            "name": name,
            "description": desc,
            "outOfScope": False,
            "reasonOutOfScope": "",
            "privilegeLevel": "",
            "hasOpenThreats": False,
            "threats": []
        }
    }

def store(name, x, y, z):
    return {
        "position": {"x": x, "y": y},
        "size": {"width": 185, "height": 80},
        "attrs": {
            "text": {"text": name},
            "topLine": {"stroke": "#333333", "strokeWidth": 1, "strokeDasharray": None},
            "bottomLine": {"stroke": "#333333", "strokeWidth": 1, "strokeDasharray": None}
        },
        "shape": "store",
        "zIndex": z,
        "id": ids["db"],
        "data": {
            "type": "tm.Store",
            "name": name,
            "description": "Stores examination marks, student records, user accounts and transcript data.",
            "outOfScope": False,
            "reasonOutOfScope": "",
            "isALog": False,
            "storesCredentials": True,
            "isEncrypted": False,
            "isSigned": False,
            "hasOpenThreats": False,
            "threats": []
        }
    }

def flow(src, dst, label, z, vertices=None, protocol="HTTPS", encrypted=True, public=False):
    return {
        "shape": "flow",
        "attrs": {
            "line": {
                "stroke": "#333333",
                "strokeWidth": 1,
                "targetMarker": {"name": "classic"},
                "strokeDasharray": None
            }
        },
        "width": 200,
        "height": 100,
        "zIndex": z,
        "connector": "smooth",
        "data": {
            "type": "tm.Flow",
            "name": label,
            "description": "",
            "outOfScope": False,
            "reasonOutOfScope": "",
            "protocol": protocol,
            "isEncrypted": encrypted,
            "isPublicNetwork": public,
            "hasOpenThreats": False,
            "threats": []
        },
        "id": uid(),
        "labels": [label],
        "source": {"cell": ids[src]},
        "target": {"cell": ids[dst]},
        "vertices": vertices or []
    }

def boundary(x, name, z):
    # one vertical boundary and one text label above it
    b = {
        "shape": "trust-broundary-curve",
        "attrs": {
            "line": {
                "stroke": "#555555",
                "strokeWidth": 1,
                "strokeDasharray": "8 5",
                "targetMarker": "",
                "sourceMarker": ""
            }
        },
        "width": 200,
        "height": 100,
        "zIndex": z,
        "connector": "smooth",
        "labels": [{"attrs": {"text": {"text": ""}}}],
        "data": {
            "type": "tm.Boundary",
            "name": name,
            "description": name,
            "isTrustBoundary": True,
            "hasOpenThreats": False
        },
        "id": uid(),
        "source": {"x": x, "y": 80},
        "target": {"x": x, "y": 760},
        "vertices": []
    }
    t = {
        "position": {"x": x - 70, "y": 30},
        "size": {"width": 140, "height": 35},
        "attrs": {"text": {"text": name}},
        "shape": "td-text-block",
        "zIndex": z+1,
        "id": uid(),
        "data": {"type": "tm.Text", "name": name, "hasOpenThreats": False}
    }
    return [b,t]

cells = []

# Main components — spacious and aligned
cells += [
    actor("student","Student", 40, 120, 1),
    actor("lecturer","Lecturer", 40, 340, 2),
    actor("admin","Administrator", 40, 560, 3),

    process("internet","Internet", 365, 340, 4,
            "Public network used to access the portal."),
    process("webapp","Web Application", 640, 340, 5,
            "User-facing university results portal."),
    process("appserver","Application Server", 900, 340, 6,
            "Processes authentication, marks, results, transcripts and approvals."),
    store("Results Database", 1175, 348, 7),
]

# Trust boundaries, short titles
for group in [
    boundary(275, "External Boundary", 8),
    boundary(565, "University Web Boundary", 10),
    boundary(1110, "Data Tier Boundary", 12),
]:
    cells.extend(group)

z = 20

# User flows: put request lane above, response lane below each actor
cells += [
    flow("student","internet","Login details / Results request",z,
         [{"x":220,"y":145},{"x":300,"y":145},{"x":330,"y":300}], public=True),
    flow("internet","student","Results / Transcript",z+1,
         [{"x":330,"y":250},{"x":300,"y":205},{"x":220,"y":205}], public=True),

    flow("lecturer","internet","Login details / Marks upload",z+2,
         [{"x":220,"y":350},{"x":300,"y":350}], public=True),
    flow("internet","lecturer","Update status",z+3,
         [{"x":300,"y":415},{"x":220,"y":415}], public=True),

    flow("admin","internet","Login details / Approval request",z+4,
         [{"x":220,"y":575},{"x":300,"y":575},{"x":330,"y":455}], public=True),
    flow("internet","admin","Admin / Approval status",z+5,
         [{"x":330,"y":500},{"x":300,"y":635},{"x":220,"y":635}], public=True),
]

# Core system flows: one upper request lane and one lower response lane
cells += [
    flow("internet","webapp","Portal request",z+6,
         [{"x":510,"y":320},{"x":590,"y":320}], public=True),
    flow("webapp","internet","Portal response",z+7,
         [{"x":590,"y":455},{"x":510,"y":455}], public=True),

    flow("webapp","appserver","Marks / Results / Transcript / Approval request",z+8,
         [{"x":790,"y":300},{"x":850,"y":300}]),
    flow("appserver","webapp","Application response",z+9,
         [{"x":850,"y":470},{"x":790,"y":470}]),

    flow("appserver","db","Read / Write marks and accounts",z+10,
         [{"x":1050,"y":305},{"x":1130,"y":305}], protocol="Database connection"),
    flow("db","appserver","Results / Student / Transcript data",z+11,
         [{"x":1130,"y":475},{"x":1050,"y":475}], protocol="Database connection"),
]

# Small legend text
legend = {
    "position": {"x": 355, "y": 700},
    "size": {"width": 850, "height": 40},
    "attrs": {"text": {"text": "DFD: University Student Results Portal — Member 1 System Architecture"}},
    "shape": "td-text-block",
    "zIndex": 40,
    "id": uid(),
    "data": {"type": "tm.Text", "name": "DFD: University Student Results Portal — Member 1 System Architecture", "hasOpenThreats": False}
}
cells.append(legend)

model = {
    "version": "2.6.2",
    "release_version": "",
    "released_at": "",
    "summary": {
        "title": "University Student Results Portal",
        "owner": "Group 1 4E",
        "description": "Threat model for a university web based student results portal used by students, lecturers and administrators",
        "id": 0
    },
    "detail": {
        "contributors": [
            {"name": "Krishna Madhaparia"},
            {"name": "Tevin Ngiru"},
            {"name": "Eeshan Vaghjiani"},
            {"name": "Dhruvin Bhudia"},
            {"name": "Philip Tait"}
        ],
        "diagrams": [{
            "id": 0,
            "title": "Student Results portal threat model",
            "diagramType": "Generic",
            "placeholder": "Organised University Student Results Portal system architecture and data flow diagram",
            "thumbnail": "./public/content/images/thumbnail.jpg",
            "version": "2.6.2",
            "cells": cells
        }],
        "diagramTop": 1,
        "reviewer": "",
        "threatTop": 0
    }
}

with open(out_path, "w", encoding="utf-8") as f:
    json.dump(model, f, indent=2, ensure_ascii=False)

# validation
with open(out_path, encoding="utf-8") as f:
    chk = json.load(f)
cell_ids = {c["id"] for c in chk["detail"]["diagrams"][0]["cells"]}
flows = [c for c in chk["detail"]["diagrams"][0]["cells"] if c.get("data",{}).get("type")=="tm.Flow"]
assert all(fl["source"]["cell"] in cell_ids and fl["target"]["cell"] in cell_ids for fl in flows)

print("Created organised Threat Dragon v2.6.2 file:")
print(out_path)
print("Components + boundaries + flows:", len(cells))
print("Data flows:", len(flows))
